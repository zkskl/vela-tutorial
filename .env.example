# Salin ke .env dan isi sendiri. JANGAN commit .env.
API_BASE=https://api.example-platform.tld
DOMAIN_PLATFORM=example-platform.tld

# Cookie session (read-only). Sebaiknya simpan path, bukan nilainya.
SESSION_DB=/tmp/sess.sqlite
CONTAINERS_JSON=/path/to/containers.json

# Opsional: mining
POOL_URL=stratum+tcp://pool.example.tld:3333
POOL_ADDRESS=<ALAMAT_POOL_KAMU>
MINER_BIN=<NAMA_BINER>
